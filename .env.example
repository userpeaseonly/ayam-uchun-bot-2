# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# AI Evaluation Settings
# Provider options: deepseek, gemini
AI_PROVIDER=deepseek

# DeepSeek Configuration (OpenAI compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_IMPORT_MODEL=deepseek-flash
AI_IMPORT_TIMEOUT=180
AI_GRADING_TIMEOUT=60
GRADING_CONCURRENCY=8

# Google Gemini Configuration (Fallback/Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database & Scoring Settings
DB_PATH=bot_database.sqlite3
DEFAULT_OPEN_QUESTION_POINTS=2.5

# Local file logging; containers send logs to stdout instead.
LOG_FILE=bot.log

# Mini App: HTTPS URL on your domain; leave empty for bot-only mode.
MINI_APP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
MEDIA_PATH=data/media

# Native Telegram Stars pilot: defaults never enable purchases.
# A test-environment bot/account is separate from ordinary Telegram/BotFather.
TELEGRAM_TEST_ENVIRONMENT=false
STARS_TEST_PAYMENTS_ENABLED=false
# Keep false for fake Stars; enabling on an ordinary bot charges real Stars.
STARS_ALLOW_LIVE_TEST_PAYMENTS=false
# Required before the pilot can accept payments; your actual support username.
PAYMENT_SUPPORT_USERNAME=
# BotFather Click provider tokens are not used for XTR / Stars invoices.

# Standalone website (opened in a normal browser). Can use the same HTTPS host.
BROWSER_APP_URL=
WEB_TEST_PAYMENTS_ENABLED=false
WEB_ALLOW_LIVE_TEST_PAYMENTS=false
# Requires direct merchant contracts/credentials, not BotFather tokens.
# Click test credentials MUST identify a dedicated test service issued by Click.
CLICK_ENVIRONMENT=test
CLICK_TEST_SERVICE_ID=
CLICK_TEST_MERCHANT_ID=
CLICK_TEST_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_ENVIRONMENT=test
PAYME_TEST_MERCHANT_ID=
PAYME_TEST_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
