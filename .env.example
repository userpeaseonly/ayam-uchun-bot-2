# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# AI Evaluation Settings
# Provider options: deepseek, gemini
AI_PROVIDER=deepseek

# DeepSeek Configuration (OpenAI compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_IMPORT_MODEL=deepseek-flash
AI_IMPORT_TIMEOUT=180
AI_GRADING_TIMEOUT=60
GRADING_CONCURRENCY=8

# Google Gemini Configuration (Fallback/Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database & Scoring Settings
DB_PATH=bot_database.sqlite3
DEFAULT_OPEN_QUESTION_POINTS=2.5

# Local file logging; containers send logs to stdout instead.
LOG_FILE=bot.log

# Mini App: HTTPS URL on your domain; leave empty for bot-only mode.
MINI_APP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080
MEDIA_PATH=data/media
